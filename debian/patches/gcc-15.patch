From: Adrian Bunk <bunk@debian.org>
Date: Thu, 15 Oct 2026 14:57:45 +0100
Subject: Fix FTBFS with GCC 15

Bug-Debian: https://bugs.debian.org/1096443
---
 main.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/main.c b/main.c
index 8ecf99c..068390b 100644
--- a/main.c
+++ b/main.c
@@ -427,7 +427,7 @@ int parent_isalive()
 	return 1;
 }
 
-void child_sigchld()
+void child_sigchld(int sig)
 {
 	if ( getppid() != 1 )
 		return;
@@ -437,7 +437,7 @@ void child_sigchld()
 	return;
 }
 
-int sethandler_sigchld ( void ( *handler ) () )
+int sethandler_sigchld ( void ( *handler ) (int) )
 {
 	struct sigaction sa;
 	sa.sa_handler = handler;
